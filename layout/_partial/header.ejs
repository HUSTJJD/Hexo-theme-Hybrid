<%
	const menu = theme.menu || {};
	const social = theme.social || {};
	const brandName = theme.brand.name || config.title;
	const avatar = theme.brand.avatar ? (theme.favicon.light || theme.favicon.dark) : false;
	const currentPath = '/' + (page.path || '').replace(/index\.html$/, '');
	const notesPrefix = url_for('/notes/').replace(/\/$/, '');
	// 文章页的 permalink 是 :abbrlink.html，落在站点根目录、没有 /notes/ 前缀，
	// 但语义上属于笔记区，所以文章页也要让「笔记」菜单高亮
	const inNotes = is_post() ||
		currentPath.indexOf(notesPrefix) === 0 ||
		(page.path || '').indexOf('notes/') === 0;
	// 顶栏是否随向下滚动隐藏，由 main.js 读取
	const autoHide = !theme.appearance || theme.appearance.hide_header_on_scroll !== false;
%>
<header id="header" data-autohide="<%= autoHide ? 'true' : 'false' %>">
	<a class="brand" href="<%= url_for('/') %>">
		<% if (avatar){ %>
			<img class="brand-avatar" src="<%= url_for(avatar) %>" alt="<%= brandName %>">
		<% } %>
		<span class="brand-name"><%= brandName %></span>
	</a>

	<nav id="menu" aria-label="<%= __('aria.menu') %>">
		<% Object.keys(menu).forEach(function(name){
			const item = menu[name] || {};
			const url = url_for(item.url || '/');
			const active = item.url === '/'
				? (page.path === 'index.html' || page.path === '')
				: item.url === '/notes/'
					? inNotes
					: currentPath.indexOf(url_for(item.url).replace(/\/$/, '')) === 0;
		%>
			<a class="menu-item<%- active ? ' active' : '' %>" href="<%= url %>">
				<% if (item.icon){ %><i class="fa fa-<%= item.icon %>" aria-hidden="true"></i><% } %>
				<span><%= name %></span>
			</a>
		<% }); %>
	</nav>

	<div class="header-actions">
		<% Object.keys(social).forEach(function(key){
			const item = social[key] || {};
			if (!item.enable) return;
		%>
			<a class="icon-btn" href="<%= item.url %>" aria-label="<%= key %>"
				<%= key === 'github' || key === 'email' ? '' : 'target=\"_blank\" rel=\"noopener\"' %>>
				<i class="fa fa-<%= item.icon || key %>" aria-hidden="true"></i>
			</a>
		<% }); %>

		<button class="icon-btn scheme-toggle" type="button" aria-label="<%= __('aria.theme_toggle') %>">
			<i class="fa fa-moon-o" aria-hidden="true"></i>
		</button>

		<button class="icon-btn nav-toggle" type="button" aria-label="<%= __('aria.open_menu') %>">
			<i class="fa fa-bars" aria-hidden="true"></i>
		</button>
	</div>
</header>
