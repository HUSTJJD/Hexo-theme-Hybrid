<%
	const siteTitle = config.title || '';
	const pageTitle = page.title || (page.category || page.tag || '');
	const fullTitle = pageTitle ? pageTitle + ' | ' + siteTitle : siteTitle + (config.subtitle ? ' | ' + config.subtitle : '');
	const description = page.description || config.description || '';
%>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="generator" content="Hexo">

	<title><%= fullTitle %></title>
	<meta name="description" content="<%= description %>">
	<% if (config.keywords){ %><meta name="keywords" content="<%= config.keywords %>"><% } %>
	<meta name="author" content="<%= config.author %>">

	<!-- 主题色，跟随深浅色 -->
	<meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#15161a" media="(prefers-color-scheme: dark)">

	<% if (theme.favicon.dark){ %><%- favicon_tag(theme.favicon.dark) %><% } %>

	<!-- 样式：先加载令牌，再加载组件 -->
	<link rel="stylesheet" href="https://unpkg.com/font-awesome@4.7.0/css/font-awesome.min.css">
	<%- css('css/tokens.css') %>
	<%- css('css/base.css') %>
	<%- css('css/home.css') %>
	<%- css('css/wiki.css') %>
	<%- css('css/markdown.css') %>
	<%- css('css/markdown.css') %>

	<!-- 数学公式（KaTeX）：只在启用时加载 -->
	<% if (theme.markdown && theme.markdown.katex && theme.markdown.katex.enable){ %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@<%= theme.markdown.katex.version %>/dist/katex.min.css">
	<% } %>

	<!-- 数学公式样式：构建期已渲染成 HTML，这里只补 CSS -->
	<% if (theme.markdown && theme.markdown.math && theme.markdown.math.enable){ %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@<%= theme.markdown.math.version %>/dist/katex.min.css">
	<% } %>

	<!-- 自定义样式 -->
	<% if (theme.custom.css.path){ %>
		<% theme.custom.css.path.forEach(function(item){ %>
			<%- css(item) %>
		<% }); %>
	<% } %>

	<!-- 自定义脚本（首屏） -->
	<% if (theme.custom.js.path){ %>
		<% theme.custom.js.path.forEach(function(item){ %>
			<%- js(item) %>
		<% }); %>
	<% } %>

	<!-- 主题运行时配置，供 js/main.js 读取 -->
	<script>
		window.__hybrid = {
			mermaid: {
				enable: <%= !!(theme.markdown && theme.markdown.mermaid && theme.markdown.mermaid.enable) %>,
				version: '<%= (theme.markdown && theme.markdown.mermaid && theme.markdown.mermaid.version) || "12.1.0" %>',
				theme: '<%= (theme.markdown && theme.markdown.mermaid && theme.markdown.mermaid.theme) || "default" %>'
			}
		};
	</script>

	<!-- 分析 -->
	<% if (theme.analytics.baidu.enable && theme.analytics.baidu.hm){ %>
		<script>
			var _hmt = _hmt || [];
			(function () {
				var hm = document.createElement("script");
				hm.src = "https://hm.baidu.com/hm.js?<%= theme.analytics.baidu.hm %>";
				document.head.appendChild(hm);
			})();
		</script>
	<% } %>
	<% if (theme.analytics.google.enable && theme.analytics.google.id){ %>
		<script async src="https://www.googletagmanager.com/gtag/js?id=<%= theme.analytics.google.id %>"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', '<%= theme.analytics.google.id %>');
		</script>
	<% } %>
</head>
