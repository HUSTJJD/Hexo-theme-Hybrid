<!-- 开合按钮在文件末尾、#sidebar 之外：#sidebar.is-collapsed 会加 transform，
     而带 transform 的元素会成为内部 position:fixed 子元素的包含块，
     按钮会被一起移出屏幕，变成「能收起、没法展开」 -->
<aside id="sidebar" aria-label="<%= __('aria.sidebar') %>">
	<div id="site-toc">
		<a class="toc-home" href="<%= url_for('/notes/') %>">
			<i class="fa fa-sitemap" aria-hidden="true"></i>
			<span><%= __('notes.all') %></span>
			<span class="toc-count"><%= site.posts.length %></span>
		</a>

		<div class="search-wrap">
			<i class="fa fa-search" aria-hidden="true"></i>
			<input id="search-input" class="search-input" type="search" autocomplete="off"
				data-engine="<%= (theme.sidebar && theme.sidebar.search && theme.sidebar.search.engine) || 'https://www.google.com/search?q=' %>"
				placeholder="<%= __('search.placeholder') %>">
		</div>

		<div id="tree">
			<%
				// 目录树必须来自 _posts 的实际路径。slug 可以被 front-matter 改写，
				// permalink 更可能完全不含目录信息，都不适合作为树的结构来源。
				const postTreePath = (post) => {
					let raw = post && post.source ? String(post.source) : String((post && post.slug) || '');
					return raw.replace(/\\/g, '/')
						.replace(/^_posts\//, '')
						.replace(/\.md$/i, '')
						.replace(/^\/+|\/+$/g, '');
				};

				const newNode = (name, path) => ({ name: name, path: path, post: null, children: new Map() });
				const rootNode = newNode('', '');

				site.posts.forEach(function (post) {
					const parts = postTreePath(post).split('/').filter(Boolean);
					if (!parts.length) return;

					let parent = rootNode;
					parts.forEach(function (part, index) {
						const path = parent.path ? parent.path + '/' + part : part;
						if (!parent.children.has(part)) parent.children.set(part, newNode(part, path));
						parent = parent.children.get(part);
						if (index === parts.length - 1) parent.post = post;
					});
				});

				const sortedChildren = (node, skip) => Array.from(node.children.values())
					.filter(function (child) { return child !== skip; })
					.sort(function (a, b) {
						const aDirectory = a.children.size > 0;
						const bDirectory = b.children.size > 0;
						if (aDirectory !== bDirectory) return aDirectory ? -1 : 1;
						return a.name.localeCompare(b.name);
					});

				const currentId = page && page._id;
				let branchId = 0;

				const showNodes = (nodes) => {
					nodes.forEach(function (node) {
						// 推荐结构是 folder/folder.md；同时兼容同级的 folder.md + folder/。
						const namedIndex = node.children.get(node.name);
						const nestedIndex = namedIndex && namedIndex.post && namedIndex.children.size === 0
							? namedIndex : null;
						const indexPost = node.post || (nestedIndex && nestedIndex.post) || null;
						const children = sortedChildren(node, nestedIndex);
						const isDirectory = children.length > 0;
						const active = !!(indexPost && currentId && indexPost._id === currentId);
						const label = theme.sidebar && theme.sidebar.usePostTitle && indexPost
							? (indexPost.title || node.name) : node.name;
						const href = indexPost ? url_for(indexPost.path) : '';
						const childId = isDirectory ? 'tree-branch-' + (++branchId) : '';
			%>
				<li class="tree-node <%= isDirectory ? 'directory' : 'file' %><%= active ? ' active' : '' %>"
					data-tree-key="<%= node.path %>" data-tree-label="<%= label %>">
					<div class="tree-row">
			<% if (isDirectory) { %>
						<button class="tree-toggle" type="button" aria-expanded="false"
							aria-controls="<%= childId %>" title="<%= node.path %>">
							<i class="fa fa-angle-right" aria-hidden="true"></i>
							<span><%= label %></span>
						</button>
						<% if (indexPost) { %>
							<% if (href) { %>
								<a class="dir-index" href="<%- href %>" title="<%= __('toc.index_note') %>"
									aria-label="<%= __('toc.index_note') %>">
									<i class="fa fa-file-text-o" aria-hidden="true"></i>
								</a>
							<% } else { %>
								<span class="dir-index is-current" title="<%= __('toc.index_note') %>" aria-current="page">
									<i class="fa fa-file-text-o" aria-hidden="true"></i>
								</span>
							<% } %>
						<% } %>
			<% } else if (indexPost) { %>
						<a class="tree-link"<% if (href) { %> href="<%- href %>"<% } %>
							title="<%= node.path %>"<% if (active) { %> aria-current="page"<% } %>><%= label %></a>
			<% } %>
					</div>

					<% if (active) { %>
						<nav class="article-toc" aria-label="<%= page.title %>" hidden></nav>
					<% } %>

					<% if (isDirectory) { %>
						<ul id="<%= childId %>" class="tree-children" hidden>
							<% showNodes(children); %>
						</ul>
					<% } %>
				</li>
			<%
					});
				};
			%>

			<ul class="tree-root">
				<% showNodes(sortedChildren(rootNode)); %>
			</ul>
		</div>
	</div>
</aside>

<button id="sidebar-toggle" class="toggle" type="button" aria-label="<%= __('toc.collapse') %>" title="<%= __('toc.collapse') %>">
	<i class="fa fa-arrow-right" aria-hidden="true"></i>
</button>
