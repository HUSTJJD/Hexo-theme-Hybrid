<!-- 开合按钮在文件末尾、#sidebar 之外：#sidebar.is-collapsed 会加 transform，
     而带 transform 的元素会成为内部 position:fixed 子元素的包含块，
     按钮会被一起移出屏幕，变成「能收起、没法展开」 -->
<aside id="sidebar" aria-label="<%= __('aria.sidebar') %>">
	<div id="site-toc">
		<a class="toc-home" href="<%= url_for('/notes/') %>">
			<i class="fa fa-sitemap" aria-hidden="true"></i>
			<span><%= __('notes.all') %></span>
			<span class="toc-count"><%= site.posts.length %></span>
		</a>

		<div class="search-wrap">
			<i class="fa fa-search" aria-hidden="true"></i>
			<input id="search-input" class="search-input" type="search" autocomplete="off"
				data-engine="<%= (theme.sidebar && theme.sidebar.search && theme.sidebar.search.engine) || 'https://www.google.com/search?q=' %>"
				placeholder="<%= __('search.placeholder') %>">
		</div>

		<div id="tree">
			<%
				// 当前页面在目录树中的路径：
				// 文章用 slug（形如 LLM/TiniestGPT/11-frontier），其余页面用输出路径去扩展名。
				// 旧写法用 page.path 取最后一段，permalink 为 :abbrlink.html 时永远匹配不上，
				// 导致索引页进目录树后没有任何 active 节点、树被整体收起。
				const pagePath = (function () {
					let raw = '';
					if (is_post() && page.slug) raw = String(page.slug);
					else if (page.source) raw = String(page.source).replace(/^_posts\//, '').replace(/\.md$/i, '');
					else if (page.path) raw = String(page.path).replace(/\.html?$/i, '');
					return raw.replace(/^\/+|\/+$/g, '');
				})();

				// 把文章路径转换成树形目录结构
				const pathToTree = (treeNodes) => {
					var output = [];
					treeNodes.forEach(function(post){
						var chain = post.slug.split("/");
						var currentNode = output;
						for (var j = 0; j < chain.length; j++) {
							if (chain[j] === '') {
								break;
							}
							var wantedNode = chain[j];
							var lastNode = currentNode;

							for (var k = 0; k < currentNode.length; k++) {
								if (currentNode[k].title == wantedNode) {
									currentNode = currentNode[k].children;
									break;
								}
							}

							if (lastNode == currentNode) {
								var newNode = currentNode[k] = { post: post, title: wantedNode, children: [] };
								currentNode = newNode.children;
							} else {
								delete currentNode.children
							}
						}
					});
					return output;
				}
			%>
			<%
				// 递归渲染目录树，prefix 是当前节点在树中的完整路径
				const showTree = (treeNodes, prefix) => {

					// 文件夹排在文件前面，同类型按标题字典序排序
					treeNodes.sort(function(a, b){
						const isFolderA = a.children && a.children.length > 0;
						const isFolderB = b.children && b.children.length > 0;

						if (isFolderA && !isFolderB) return -1;
						if (!isFolderA && isFolderB) return 1;

						return a.title.localeCompare(b.title);
					});

					treeNodes.forEach(function(node) {
						const nodePath = prefix ? prefix + '/' + node.title : node.title;

						if ( node.children == 0 ) {
							const fileActive = (is_post() && node.post._id == page._id) || nodePath === pagePath;
			%>
							<ul>
								<li class="file<%- fileActive ? ' active' : '' %>">
									<a href="<%- url_for(node.post.path) %>" title="<%- nodePath %>">
									<% if (theme.sidebar && theme.sidebar.usePostTitle) { %>
										<%- node.post.title || node.title %>
									<% } else { %>
										<%- node.title %>
									<% } %>
									</a>
								</li>
								<div class="article-toc" style="display: none;"></div>
							</ul>
			<%
						} else {
							// 与目录同名的那篇笔记就是该目录的索引笔记
							let parent;
							let childrens = [];
							node.children.forEach(child => {
								const titleList = child.post.slug.split("/");
								const title = titleList.slice(-1)[0];
								if(node.title === title) {
									parent = child;
								} else {
									childrens.push(child);
								}
							});

							const hasIndex = !!parent;
							const indexUrl = hasIndex ? url_for(parent.post.path) : '';
							// 索引页的路径是「目录路径 + / + 目录名」
							const indexPath = nodePath + '/' + node.title;
							const dirActive = hasIndex && indexPath === pagePath;
							// 目录下只有索引笔记、没有其它子项时，它本质就是一个页面：
							// 按文件节点渲染，不给展开图标（否则点了没有任何反应），点击直接打开索引笔记
							const leafDir = hasIndex && childrens.length === 0;
			%>
							<ul>
			<% 					if(leafDir){ %>
									<li class="file<%- (is_post() && parent.post._id == page._id) || indexPath === pagePath ? ' active' : '' %>">
										<%# relative_link 下指向当前页的链接会是空串，这里就不写 href %>
										<a<% if (indexUrl) { %> href="<%- indexUrl %>"<% } %> title="<%- indexPath %>">
										<% if (theme.sidebar && theme.sidebar.usePostTitle) { %>
											<%- parent.post.title || node.title %>
										<% } else { %>
											<%- node.title %>
										<% } %>
										</a>
									</li>
									<div class="article-toc" style="display: none;"></div>
			<% 					} else { %>
								<li class="directory">
			<% 						if(hasIndex){ %>
										<%# relative_link 下指向当前页的链接会是空串，这里就不写 href %>
										<a class="directory <%- dirActive ? 'active' : '' %>"<% if (indexUrl) { %> href="<%- indexUrl %>"<% } %> title="<%- nodePath %>">
											<i class="fa fa-plus-square-o"></i>
											<%- node.title %>
										</a>
			<% 						} else { %>
										<a title="<%- nodePath %>" class="directory-empty">
											<i class="fa fa-plus-square-o"></i>
											<%- node.title %>
										</a>
			<% 						} %>
									<div class="article-toc" style="display: none;"></div>
			<% 						if(hasIndex && indexUrl){ %>
										<%# 目录行只负责展开/折叠，索引笔记通过这个入口打开 %>
										<a class="dir-index" href="<%- indexUrl %>" title="<%= __('toc.index_note') %>" aria-label="<%= __('toc.index_note') %>">
											<i class="fa fa-file-text-o" aria-hidden="true"></i>
										</a>
			<% 						} %>
									<%- showTree(childrens, nodePath) %>
								</li>
			<% 					} %>
							</ul>
			<%
						}
					});
				}
				showTree(pathToTree(site.posts), '')
			%>
		</div>
	</div>
</aside>

<button id="sidebar-toggle" class="toggle" type="button" aria-label="<%= __('toc.collapse') %>" title="<%= __('toc.collapse') %>">
	<i class="fa fa-arrow-right" aria-hidden="true"></i>
</button>
