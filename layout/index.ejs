<%
	// /notes/ 只负责「时间视角」：一条按更新时间倒序的全量笔记流。
	// 分类在这里只是导航入口（chip 行），完整的「分类 -> 文章」地图在 /categories/，
	// 精选的几条在首页 —— 三处各司其职，不再互相抄一遍。
	const groups = cat_groups();
%>

<div class="notes-index">

	<header class="notes-head">
		<h1 class="notes-title"><%= __('notes.title') %></h1>
		<p class="notes-desc"><%= __('notes.desc', site.posts.length) %></p>

		<ul class="notes-stats">
			<li><b><%= site.posts.length %></b><span><%= __('unit.post') %></span></li>
			<li><b><%= groups.length %></b><span><%= __('unit.category') %></span></li>
			<li><b><%= site.tags.length %></b><span><%= __('unit.tag') %></span></li>
		</ul>
	</header>

	<% if (groups.length){ %>
		<nav class="cat-nav" aria-label="<%= __('category.title') %>">
			<a class="cat-nav-item cat-nav-all" href="<%= url_for('/categories/') %>">
				<i class="fa fa-th-large" aria-hidden="true"></i>
				<span><%= __('notes.by_category') %></span>
				<i class="fa fa-angle-right" aria-hidden="true"></i>
			</a>
			<% groups.forEach(function(g){ %>
				<a class="cat-nav-item tone-<%= g.color %>" href="<%= url_for(g.cat.path) %>">
					<i class="fa fa-<%= g.icon %>" aria-hidden="true"></i>
					<span><%= g.name %></span>
					<em><%= g.count %></em>
				</a>
			<% }); %>
		</nav>
	<% } %>

	<h2 class="notes-subtitle">
		<%= __('notes.list') %>
		<span class="notes-subtitle-count"><%= site.posts.length %></span>
	</h2>

	<div class="post-list">
		<% page.posts.each(function(post){
			const cat = post.categories && post.categories.length ? post.categories.data[0].name : '';
			const brief = strip_html(post.excerpt || post.content || '').substring(0, 120);
		%>
			<a class="post-item" href="<%= url_for(post.path) %>">
				<div class="post-item-main">
					<div class="post-item-title"><%= post.title %></div>
					<% if (brief){ %><p class="post-item-brief"><%= brief %>…</p><% } %>
				</div>
				<div class="post-item-meta">
					<% if (cat){ %><span class="chip chip-soft"><%= cat %></span><% } %>
					<time><%= date(post.updated || post.date, 'YYYY-MM-DD') %></time>
				</div>
			</a>
		<% }); %>
	</div>

	<% if (page.total > 1){ %>
		<nav class="pagination-wrap">
			<%- paginator({ prev_text: '<i class="fa fa-angle-left"></i>', next_text: '<i class="fa fa-angle-right"></i>', escape: false }) %>
		</nav>
	<% } %>

</div>
