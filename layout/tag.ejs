<%
	const current = page.tag;
	const list = current ? (page.posts || []) : site.tags;
%>
<div class="page">
	<h1 class="page-title">
		<%= current ? '#' + current : __('tag.title') %>
		<% if (current){ %><span class="page-count"><%= list.length %> <%= __('unit.post') %></span><% } %>
	</h1>

	<% if (!current){ %>
		<div class="chip-cloud">
			<% site.tags.forEach(function(t){ %>
				<a class="chip chip-lg" href="<%= url_for(t.path) %>"><%= t.name %> <em><%= t.posts.length %></em></a>
			<% }); %>
		</div>
	<% } else { %>
		<div class="post-list">
			<% list.each(function(post){ %>
				<a class="post-item" href="<%= url_for(post.path) %>">
					<div class="post-item-main">
						<div class="post-item-title"><%= post.title %></div>
					</div>
					<div class="post-item-meta"><time><%= date(post.date, 'YYYY-MM-DD') %></time></div>
				</a>
			<% }); %>
		</div>
	<% } %>
</div>
