<%
	const profile = site.data.profile || {};
	const recentCount = theme.notes.recent_count || 6;
	const github = (theme.social && theme.social.github && theme.social.github.url) || '';
%>
<div class="home">

	<!-- Hero -->
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-avatar">
				<img src="<%= profile.avatar || theme.favicon.light %>" alt="<%= profile.name || config.author %>">
			</div>

			<div class="hero-text">
				<h1 class="hero-name"><%= profile.name || config.author %></h1>
				<% const tagline = profile.tagline || config.subtitle || ''; %>
				<% if (tagline){ %><p class="hero-tagline"><%= tagline %></p><% } %>

				<% if (profile.meta && profile.meta.length){ %>
					<ul class="hero-meta">
						<% profile.meta.forEach(function(m){ %>
							<li>
								<% if (m.icon){ %><i class="fa fa-<%= m.icon %>" aria-hidden="true"></i><% } %>
								<% if (m.url){ %><a href="<%= m.url %>" <%= m.url.indexOf('mailto:') === 0 ? '' : 'target=\"_blank\" rel=\"noopener\"' %>><%= m.text %></a><% } else { %><span><%= m.text %></span><% } %>
							</li>
						<% }); %>
					</ul>
				<% } %>

				<div class="hero-actions">
					<a class="btn btn-primary" href="<%= url_for('/notes/') %>">
						<i class="fa fa-sitemap" aria-hidden="true"></i> <%= __('home.enter') %>
					</a>
					<% if (github){ %>
						<a class="btn btn-ghost" href="<%= github %>" target="_blank" rel="noopener">
							<i class="fa fa-github" aria-hidden="true"></i> GitHub
						</a>
					<% } %>
				</div>
			</div>
		</div>
	</section>

	<!-- 自述正文（来自 source/index.md） -->
	<% if (page.content){ %>
		<section class="section section-intro">
			<div class="prose">
				<%- page.content %>
			</div>
		</section>
	<% } %>

	<!-- 最近更新 -->
	<section class="section" id="recent">
		<div class="section-head">
			<h2 class="section-title"><i class="fa fa-clock-o" aria-hidden="true"></i> <%= __('notes.recent') %></h2>
			<a class="section-more" href="<%= url_for('/notes/') %>"><%= __('notes.more') %> <i class="fa fa-angle-right" aria-hidden="true"></i></a>
		</div>

		<div class="note-grid">
			<% site.posts.sort('updated', -1).limit(recentCount).each(function(post){
				const cat = post.categories && post.categories.length ? post.categories.data[0].name : '';
			%>
				<a class="note-card" href="<%= url_for(post.path) %>">
					<div class="note-card-title"><%= post.title %></div>
					<div class="note-card-meta">
						<% if (cat){ %><span class="chip chip-soft"><%= cat %></span><% } %>
						<time><%= date(post.updated || post.date, 'YYYY-MM-DD') %></time>
					</div>
				</a>
			<% }); %>
		</div>
	</section>

</div>
