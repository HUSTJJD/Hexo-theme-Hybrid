<%
	const home = site.data.home || {};
	const profile = site.data.profile || {};
	const works = site.data.works || {};
	const papers = site.data.papers || {};
	const projData = site.data.projects || {};
	const projects = projData.projects || [];
	const recentCount = theme.notes.recent_count || 6;
	const github = (theme.social && theme.social.github && theme.social.github.url) || '';
	const tagline = profile.tagline || config.subtitle || '';

	// 区块标题：大写 + 尾部符号，符号缺省为空
	function sectionTitle(cfg, fallback, symbol){
		return (cfg && cfg.title) || fallback;
	}
%>
<div class="home">

	<!-- Hero -->
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-avatar">
				<img src="<%= profile.avatar || theme.favicon.light %>" alt="<%= profile.name || config.author %>">
			</div>

			<div class="hero-text">
				<p class="hero-eyebrow"><%= home.eyebrow || 'HI, THERE!' %></p>
				<h1 class="hero-name"><%= profile.name || config.author %></h1>
				<% if (tagline){ %><p class="hero-tagline"><%= tagline %></p><% } %>

				<% if (profile.meta && profile.meta.length){ %>
					<ul class="hero-meta">
						<% profile.meta.forEach(function(m){ %>
							<li>
								<% if (m.icon){ %><i class="fa fa-<%= m.icon %>" aria-hidden="true"></i><% } %>
								<% if (m.url){ %><a href="<%= m.url %>" <%= m.url.indexOf('mailto:') === 0 ? '' : 'target=\"_blank\" rel=\"noopener\"' %>><%= m.text %></a><% } else { %><span><%= m.text %></span><% } %>
							</li>
						<% }); %>
					</ul>
				<% } %>

				<div class="hero-actions">
					<a class="btn btn-primary" href="<%= url_for('/notes/') %>">
						<i class="fa fa-sitemap" aria-hidden="true"></i> <%= home.enter || 'Browse notes' %>
					</a>
					<% if (github){ %>
						<a class="btn btn-ghost" href="<%= github %>" target="_blank" rel="noopener">
							<i class="fa fa-github" aria-hidden="true"></i> GitHub
						</a>
					<% } %>
				</div>
			</div>
		</div>

		<% if (profile.highlights && profile.highlights.length){ %>
			<ul class="hero-highlights">
				<% profile.highlights.forEach(function(h){ %>
					<li><i class="fa fa-angle-right" aria-hidden="true"></i> <%= h %></li>
				<% }); %>
			</ul>
		<% } %>
	</section>

	<!-- 自述正文（来自 source/index.md） -->
	<% if (page.content){ %>
		<section class="section section-intro">
			<div class="prose">
				<%- page.content %>
			</div>
		</section>
	<% } %>

	<!-- WORKS：工作经历 -->
	<% const exp = works.experience || {}; %>
	<% if (exp.groups && exp.groups.length){ %>
		<section class="section" id="works">
			<div class="section-head">
				<h2 class="section-title"><i class="fa fa-<%= exp.icon || 'briefcase' %>" aria-hidden="true"></i> <%= sectionTitle(exp, 'WORKS') %></h2>
			</div>

			<div class="entry-groups">
				<% exp.groups.forEach(function(g){ %>
					<div class="entry-group">
						<div class="entry-group-head">
							<h3 class="entry-org"><%= g.org %></h3>
							<% if (g.role){ %><span class="entry-role"><%= g.role %></span><% } %>
							<span class="entry-meta">
								<%= g.period || '' %><% if (g.location){ %> · <%= g.location %><% } %>
							</span>
						</div>
						<% if (g.items && g.items.length){ %>
							<ul class="entry-items">
								<% g.items.forEach(function(it){ %>
									<li>
										<span class="entry-name"><%= it.name %></span>
										<% if (it.desc){ %><p class="entry-desc"><%= it.desc %></p><% } %>
									</li>
								<% }); %>
							</ul>
						<% } %>
					</div>
				<% }); %>
			</div>
		</section>
	<% } %>

	<!-- EDUCATION：学习经历 -->
	<% const edu = works.education || {}; %>
	<% if (edu.groups && edu.groups.length){ %>
		<section class="section" id="education">
			<div class="section-head">
				<h2 class="section-title"><i class="fa fa-<%= edu.icon || 'graduation-cap' %>" aria-hidden="true"></i> <%= sectionTitle(edu, 'EDUCATION') %></h2>
			</div>

			<div class="entry-groups">
				<% edu.groups.forEach(function(g){ %>
					<div class="entry-group">
						<div class="entry-group-head">
							<h3 class="entry-org"><%= g.org %></h3>
							<% if (g.role){ %><span class="entry-role"><%= g.role %></span><% } %>
							<span class="entry-meta">
								<%= g.period || '' %><% if (g.location){ %> · <%= g.location %><% } %>
							</span>
						</div>
						<% if (g.items && g.items.length){ %>
							<ul class="entry-items">
								<% g.items.forEach(function(it){ %>
									<li>
										<span class="entry-name"><%= it.name %></span>
										<% if (it.desc){ %><p class="entry-desc"><%= it.desc %></p><% } %>
									</li>
								<% }); %>
							</ul>
						<% } %>
					</div>
				<% }); %>
			</div>
		</section>
	<% } %>

	<!-- PROJECTS：开源项目 -->
	<% if (projects.length){ %>
		<section class="section" id="projects">
			<div class="section-head">
				<h2 class="section-title"><i class="fa fa-<%= projData.icon || 'code' %>" aria-hidden="true"></i> <%= projData.title || 'PROJECTS' %></h2>
				<% if (github){ %>
					<a class="section-more" href="<%= github %>" target="_blank" rel="noopener"><%= home.more || 'More' %> <i class="fa fa-angle-right" aria-hidden="true"></i></a>
				<% } %>
			</div>

			<div class="project-grid">
				<% projects.forEach(function(p){ %>
					<article class="project-card">
						<div class="project-card-head">
							<% if (p.icon){ %><span class="project-icon"><i class="fa fa-<%= p.icon %>" aria-hidden="true"></i></span><% } %>
							<h3 class="project-card-title"><%= p.name %></h3>
							<% if (p.status){ %><span class="chip chip-soft"><%= p.status %></span><% } %>
						</div>

						<% if (p.tagline){ %><p class="project-card-tagline"><%= p.tagline %></p><% } %>
						<% if (p.desc){ %><p class="project-card-desc"><%= p.desc %></p><% } %>

						<% if (p.tags && p.tags.length){ %>
							<div class="project-tags">
								<% p.tags.forEach(function(t){ %><span class="chip"><%= t %></span><% }); %>
							</div>
						<% } %>

						<div class="project-links">
							<% if (p.url){ %>
								<a class="btn btn-primary" href="<%= p.url %>" target="_blank" rel="noopener">
									<i class="fa fa-book" aria-hidden="true"></i> <%= home.docs || 'Docs' %>
								</a>
							<% } %>
							<% if (p.repo){ %>
								<a class="github-button" href="<%= p.repo %>"
									data-icon="octicon-star" data-size="large" data-show-count="true"
									aria-label="Star <%= p.repo.replace('https://github.com/','') %> on GitHub"><%= home.source || 'Source' %></a>
							<% } %>
						</div>
					</article>
				<% }); %>
			</div>
		</section>
	<% } %>

	<!-- PAPERS / PATENTS：学术成果 -->
	<% [
			{ cfg: papers.papers, fallback: 'PAPERS', id: 'papers' },
			{ cfg: papers.patents, fallback: 'PATENTS', id: 'patents' }
		].forEach(function(sec){
			const cfg = sec.cfg;
			if (!cfg || !cfg.items || !cfg.items.length) return;
	%>
		<section class="section" id="<%= sec.id %>">
			<div class="section-head">
				<h2 class="section-title"><i class="fa fa-<%= cfg.icon || 'file-text-o' %>" aria-hidden="true"></i> <%= cfg.title || sec.fallback %></h2>
			</div>

			<ul class="pub-list">
				<% cfg.items.forEach(function(it){ %>
					<li class="pub-item">
						<div class="pub-title">
							<% if (it.url){ %>
								<a href="<%= it.url %>" target="_blank" rel="noopener"><%= it.title %></a>
							<% } else { %><%= it.title %><% } %>
						</div>
						<% if (it.authors){ %><div class="pub-authors"><%= it.authors %></div><% } %>
						<div class="pub-venue">
							<%= it.venue || '' %>
							<% if (it.note){ %><span class="chip chip-soft"><%= it.note %></span><% } %>
						</div>
					</li>
				<% }); %>
			</ul>
		</section>
	<% }); %>

	<!-- 最近更新 -->
	<section class="section" id="recent">
		<div class="section-head">
			<h2 class="section-title"><i class="fa fa-clock-o" aria-hidden="true"></i> <%= home.latest || 'LATEST FROM BLOG' %></h2>
			<a class="section-more" href="<%= url_for('/notes/') %>"><%= home.more || 'More' %> <i class="fa fa-angle-right" aria-hidden="true"></i></a>
		</div>

		<div class="note-grid">
			<% site.posts.sort('updated', -1).limit(recentCount).each(function(post){
				const cat = post.categories && post.categories.length ? post.categories.data[0].name : '';
			%>
				<a class="note-card" href="<%= url_for(post.path) %>">
					<div class="note-card-title"><%= post.title %></div>
					<div class="note-card-meta">
						<% if (cat){ %><span class="chip chip-soft"><%= cat %></span><% } %>
						<time><%= date(post.updated || post.date, 'YYYY-MM-DD') %></time>
					</div>
				</a>
			<% }); %>
		</div>
	</section>

</div>
