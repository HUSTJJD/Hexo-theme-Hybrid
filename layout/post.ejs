<%
	const cats = (page.categories && page.categories.data) || [];
	const tags = (page.tags && page.tags.data) || [];
%>
<article class="post" id="article">
	<header class="post-header">
		<h1 id="article-title"><%= page.title %></h1>

		<div class="post-meta">
			<% if (cats.length){ %>
				<span class="meta-item"><i class="fa fa-folder-open" aria-hidden="true"></i>
					<% cats.forEach(function(c, i){ %>
						<a href="<%= url_for(c.path) %>"><%= c.name %></a><% if (i < cats.length - 1){ %>, <% } %>
					<% }); %>
				</span>
			<% } %>
			<span class="meta-item"><i class="fa fa-calendar" aria-hidden="true"></i> <%= date(page.date, 'YYYY-MM-DD') %></span>
			<span class="meta-item"><i class="fa fa-history" aria-hidden="true"></i> <%= date(page.updated || page.date, 'YYYY-MM-DD') %></span>
			<span class="meta-item"><i class="fa fa-file-word-o" aria-hidden="true"></i> <%= Math.round(page.content.replace(/<[^>]+>/g, '').length / 1.6) %> <%= __('post.words') %></span>
		</div>

		<% if (tags.length){ %>
			<div class="post-tags">
				<% tags.forEach(function(t){ %><a class="chip" href="<%= url_for(t.path) %>"># <%= t.name %></a><% }); %>
			</div>
		<% } %>
	</header>

	<div id="article-content" class="prose">
		<%- page.content %>
	</div>

	<%- partial('_partial/post/copyright') %>

	<nav class="post-guide">
		<% if (page.prev){ %>
			<a class="guide-prev" href="<%= url_for(page.prev.path) %>">
				<span class="guide-label"><i class="fa fa-angle-left" aria-hidden="true"></i> <%= __('post.prev') %></span>
				<span class="guide-title"><%= page.prev.title %></span>
			</a>
		<% } %>
		<% if (page.next){ %>
			<a class="guide-next" href="<%= url_for(page.next.path) %>">
				<span class="guide-label"><%= __('post.next') %> <i class="fa fa-angle-right" aria-hidden="true"></i></span>
				<span class="guide-title"><%= page.next.title %></span>
			</a>
		<% } %>
	</nav>

	<%- partial('_partial/post/comment') %>
</article>
